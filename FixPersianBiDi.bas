Attribute VB_Name = "FixPersianBiDi"
' ==========================================================================
' Project: Microsoft Word Persian/English BiDi Punctuation & Image Fixer
' Description: Fixes misplaced parentheses/colons in mixed RTL/LTR texts
'              generated by AI and centers all inline/floating images.
' License: MIT
' ==========================================================================

Sub FixAllParenthesesAndImages()
    Dim doc As Document
    Set doc = ActiveDocument
    Dim rlm As String
    Dim iShape As InlineShape
    Dim shp As Shape
    
    rlm = ChrW(8207) ' Right-to-Left Mark (RLM - U+200F)
    
    ' 1. Make all paragraphs Right-to-Left and Right-Aligned
    doc.Paragraphs.ReadingOrder = wdReadingOrderRtl
    doc.Paragraphs.Alignment = wdAlignParagraphRight
    doc.Content.LanguageID = wdPersian
    
    With doc.Content.Find
        .ClearFormatting
        .Replacement.ClearFormatting
        .MatchWildcards = False
        
        ' Step A: Clean up any existing RLM characters first to prevent duplicates
        .Execute FindText:=rlm, ReplaceWith:="", Replace:=wdReplaceAll
        
        ' Step B: Lock BOTH opening and closing parentheses and colons with RLM
        .Execute FindText:="(", ReplaceWith:=rlm & "(", Replace:=wdReplaceAll
        .Execute FindText:=")", ReplaceWith:=")" & rlm, Replace:=wdReplaceAll
        .Execute FindText:=":", ReplaceWith:=rlm & ":", Replace:=wdReplaceAll
        
        ' Step C: Clean up any accidental double RLMs
        .Execute FindText:=rlm & rlm, ReplaceWith:=rlm, Replace:=wdReplaceAll
    End With
    
    ' 2. Center all Inline Images (In Line with Text)
    For Each iShape In doc.InlineShapes
        iShape.Range.ParagraphFormat.Alignment = wdAlignParagraphCenter
    Next iShape
    
    ' 3. Center all Floating Images (Shapes)
    On Error Resume Next
    For Each shp In doc.Shapes
        shp.RelativeHorizontalPosition = wdRelativeHorizontalPositionMargin
        shp.Left = wdShapeCenter
    Next shp
    On Error GoTo 0
    
    MsgBox "Done! All punctuation fixed and images centered.", vbInformation
End Sub
